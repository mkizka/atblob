{
  "name": "@atblob/cli",
  "version": "0.6.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkizka/atblob.git",
    "directory": "packages/cli"
  },
  "license": "AGPL-3.0-only",
  "bin": {
    "atblob": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "eslint --fix . && prettier --write --log-level warn .",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@atblob/core": "workspace:*",
    "@atblob/hono": "workspace:*",
    "@hono/node-server": "2.1.6",
    "arg": "5.0.2",
    "hono": "4.13.17",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "get-port": "7.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-pkg": "0.22.1",
    "vitest": "5.1.0"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-pkg"
    ]
  }
}
